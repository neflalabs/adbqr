#compdef adbqr

_adbqr() {
    local -a options
    options=(
        '(-w --wizard)'{-w,--wizard}'[Buka menu wizard TUI interaktif]'
        '(-p --pair)'{-p,--pair}'[Pairing via QR Code (default)]'
        '(-c --connect)'{-c,--connect}'[Quick-connect ke perangkat aktif di Wi-Fi]'
        '(-s --screen)'{-s,--screen}'[Auto-launch scrcpy mirror screen setelah konek]'
        '(-u --usb)'{-u,--usb}'[Alihkan perangkat USB ke Wireless ADB port 5555]'
        '(-m --manual)'{-m,--manual}'[Pairing manual dengan 6-digit code & IP:Port]'
        '(-l --list)'{-l,--list}'[Lihat riwayat perangkat tersimpan]'
        '(-d --diag)'{-d,--diag}'[Jalankan diagnostik sistem & firewall]'
        '(-r --reset)'{-r,--reset}'[Restart ADB server & disconnect perangkat]'
        '(-t --timeout)'{-t,--timeout}'[Set timeout deteksi mDNS (detik)]:detik:(10 30 60 120)'
        '(-h --help)'{-h,--help}'[Tampilkan bantuan]'
    )
    _arguments -s $options
}

_adbqr "$@"
